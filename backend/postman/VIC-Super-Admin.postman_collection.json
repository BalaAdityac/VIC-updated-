        "url": {
          "raw": "{{baseUrl}}/api/admin/users?page=1&limit=20&role=STUDENT",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "role",
              "value": "STUDENT"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Users list succeeds', () => pm.response.to.have.status(200));",
              "const j=pm.response.json();",
              "pm.expect(j.pagination).to.have.property('total');",
              "if (j.data.length) pm.collectionVariables.set('userId', j.data[0].id);"
            ]
          }
        }
      ]
