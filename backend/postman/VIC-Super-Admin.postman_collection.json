{
  "info": {
    "name": "VIC Super Admin - Security, Management, Analytics & Audit",
    "description": "Super Admin APIs using the existing JWT login and SUPER_ADMIN role. Import, set baseUrl, login first, then run the admin requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "superAdminToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "companyToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "companyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Existing Auth Login (Super Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@vic.local\",\n  \"password\": \"StrongPassword123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.data.user.role).to.eql('SUPER_ADMIN');",
              "pm.collectionVariables.set('superAdminToken', json.data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "1 - Admin Me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{superAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin me succeeds', () => pm.response.to.have.status(200));",
              "pm.expect(pm.response.json().data.role).to.eql('SUPER_ADMIN');"
            ]
          }
        }
      ]
    },
