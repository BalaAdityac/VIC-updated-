  "item": [
    {
      "name": "Register Company A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"company-a-{$timestamp}@example.com\",\"password\":\"Password123\",\"role\":\"COMPANY\",\"companyName\":\"VIC Test Company A\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('companyToken', pm.response.json().data.token);"
            ]
          }
        }
      ]
    },
