{
  "info": {
    "name": "Placement Portal — Authentication Module",
    "description": "Register, Login, Get Current User, Update Password, Forgot Password, Logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Passw0rd!23\",\n  \"role\": \"Student\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 Created",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
          "status": "Created",
          "code": 201,
          "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful.\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"b3f1c2d4-1234-4a5b-9c6d-7e8f9a0b1c2d\",\n      \"email\": \"student@example.com\",\n      \"role\": \"Student\",\n      \"status\": \"Active\",\n      \"createdAt\": \"2026-08-08T10:00:00.000Z\",\n      \"updatedAt\": \"2026-08-08T10:00:00.000Z\"\n    },\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n  }\n}"
        },
        {
          "name": "409 Conflict — Email already exists",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/register" },
          "status": "Conflict",
          "code": 409,
          "body": "{\n  \"success\": false,\n  \"message\": \"An account with this email already exists.\",\n  \"errors\": null\n}"
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"Passw0rd!23\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/login" },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Login successful.\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"b3f1c2d4-1234-4a5b-9c6d-7e8f9a0b1c2d\",\n      \"email\": \"student@example.com\",\n      \"role\": \"Student\",\n      \"status\": \"Active\"\n    },\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n  }\n}"
        },
        {
          "name": "401 Unauthorized — Invalid credentials",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/login" },
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"message\": \"Invalid email or password.\",\n  \"errors\": null\n}"
        }
      ]
    },
    {
      "name": "Get Current User",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Current user fetched successfully.\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"b3f1c2d4-1234-4a5b-9c6d-7e8f9a0b1c2d\",\n      \"email\": \"student@example.com\",\n      \"role\": \"Student\",\n      \"status\": \"Active\"\n    }\n  }\n}"
        },
        {
          "name": "401 Unauthorized — Missing/invalid token",
          "originalRequest": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"message\": \"Authentication token missing. Please log in.\",\n  \"errors\": null\n}"
        }
      ]
    },
    {
      "name": "Update Password",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/auth/update-password", "host": ["{{baseUrl}}"], "path": ["auth", "update-password"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Passw0rd!23\",\n  \"newPassword\": \"NewPassw0rd!45\"\n}"
        }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": { "method": "PATCH", "url": "{{baseUrl}}/auth/update-password" },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Password updated successfully.\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"b3f1c2d4-1234-4a5b-9c6d-7e8f9a0b1c2d\",\n      \"email\": \"student@example.com\",\n      \"role\": \"Student\",\n      \"status\": \"Active\"\n    }\n  }\n}"
        },
        {
          "name": "401 Unauthorized — Current password incorrect",
          "originalRequest": { "method": "PATCH", "url": "{{baseUrl}}/auth/update-password" },
          "status": "Unauthorized",
          "code": 401,
          "body": "{\n  \"success\": false,\n  \"message\": \"Current password is incorrect.\",\n  \"errors\": null\n}"
        }
      ]
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\"\n}"
        }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/forgot-password" },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"If an account with that email exists, password reset instructions have been sent.\",\n  \"data\": null\n}"
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": { "method": "POST", "url": "{{baseUrl}}/auth/logout" },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"message\": \"Logged out successfully.\",\n  \"data\": null\n}"
        }
      ]
    }
  ]
}
